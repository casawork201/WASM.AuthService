@using Microsoft.AspNetCore.Components.Routing
@using TestWASM.AuthLib.Services

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject AuthService AuthService
@inject NavigationManager Nav
@implements IDisposable

@if (!AuthService.IsLoggedIn)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/login">
            <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Login 🔑
        </NavLink>
    </div>
}
else
{
    <div class="nav-item px-3 auth-user-block">
        <div class="auth-user-info" @onclick="ToggleConfirm" role="button" title="Click to log out">
            <span class="auth-avatar">@GetInitial()</span>
            <span class="auth-email" title="@AuthService.Email">@AuthService.Email</span>
        </div>

        @if (showConfirm)
        {
            <div class="logout-confirm-box">
                <span class="confirm-text">Log out? 🚪</span>
                <div class="confirm-actions">
                    <button class="btn-confirm btn-yes" @onclick="Logout" type="button">Yes ✅</button>
                    <button class="btn-confirm btn-no" @onclick="CancelLogout" type="button">No ❌</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool showConfirm = false;

    protected override void OnInitialized()
    {
        AuthService.OnChange += StateHasChanged;
    }

    private void ToggleConfirm()
    {
        showConfirm = !showConfirm;
    }

    private void CancelLogout()
    {
        showConfirm = false;
    }

    private async Task Logout()
    {
        showConfirm = false;
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }

    private string GetInitial()
    {
        var email = AuthService.Email;
        return string.IsNullOrEmpty(email) ? "?" : email[0].ToString().ToUpper();
    }

    public void Dispose()
    {
        AuthService.OnChange -= StateHasChanged;
    }
}

<style>
    .auth-user-block {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        margin-top: 0.5rem;
        padding-top: 0.75rem;
    }

    .auth-user-info {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.4rem 0.5rem;
        margin-bottom: 0.25rem;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .auth-user-info:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .auth-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        min-width: 28px;
        border-radius: 50%;
        background: linear-gradient(135deg, #11998e, #38ef7d);
        color: #fff;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

    .auth-email {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.85);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .logout-confirm-box {
        background: rgba(15, 23, 42, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        margin-top: 0.35rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }

    .confirm-text {
        font-size: 0.8rem;
        color: #cbd5e1;
        font-weight: 600;
    }

    .confirm-actions {
        display: flex;
        gap: 0.4rem;
    }

    .btn-confirm {
        flex: 1;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 700;
        cursor: pointer;
        border: none;
        transition: all 0.15s ease;
    }

    .btn-yes {
        background-color: #ef4444;
        color: #fff;
    }

    .btn-yes:hover {
        background-color: #dc2626;
    }

    .btn-no {
        background-color: #334155;
        color: #cbd5e1;
    }

    .btn-no:hover {
        background-color: #475569;
        color: #fff;
    }
</style>
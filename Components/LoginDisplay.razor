@using TestWASM.AuthLib.Components
@using TestWASM.AuthLib.Services
@using Microsoft.AspNetCore.Components.Routing
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject AuthService AuthService
@implements IDisposable

<nav class="navbar navbar-expand-lg navbar-dark px-3 px-md-4 h-100">
    <div class="container-fluid p-0">
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            <span class="brand-icon">⚡</span>
            <span class="fw-bold tracking-wide">CASA PAHAMPANG</span>
        </a>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav align-items-lg-center gap-1 gap-lg-2 mt-3 mt-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill me-1"></span> Home 🏠
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded" href="counter">
                        <span class="bi bi-plus-square-fill me-1"></span> Counter 🔢
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded" href="weather">
                        <span class="bi bi-list-nested me-1"></span> Weather ⛅
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded" href="scoreboard">
                        <span class="bi bi-display me-1"></span> Scoreboard 🏀
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded" href="scorekeeper">
                        <span class="bi bi-controller me-1"></span> Scorekeeper 🎮
                    </NavLink>
                </li>

                @if (AuthService.IsLoggedIn && AuthService.Roles.Contains("Admin", StringComparer.OrdinalIgnoreCase))
                {
                    <li class="nav-item">
                        <NavLink class="nav-link px-3 py-2 rounded text-warning" href="admin">
                            <span class="bi bi-shield-lock-fill me-1"></span> Admin Portal 🛡️
                        </NavLink>
                    </li>
                }

                <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                    <LoginDisplay />
                </li>
            </ul>
        </div>
    </div>
</nav>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AuthService.OnChange -= StateHasChanged;
    }
}

<style>
    .brand-icon {
        font-size: 1.25rem;
    }

    .navbar-brand {
        font-size: 1.15rem;
        letter-spacing: 0.5px;
        color: #ffffff !important;
    }

    .navbar-nav .nav-link {
        color: #cbd5e1 !important;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s ease-in-out;
    }

    .navbar-nav .nav-link:hover {
        color: #ffffff !important;
        background-color: rgba(255, 255, 255, 0.08);
    }

    .navbar-nav .nav-link.active {
        color: #f59e0b !important;
        background-color: rgba(245, 158, 11, 0.12);
        box-shadow: inset 0 0 0 1px rgba(245, 158, 11, 0.3);
    }

    @@media (max-width: 991.98px) {
        .navbar-collapse {
            background: #0f172a;
            padding: 1rem;
            border-radius: 12px;
            margin-top: 0.75rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    }
</style>